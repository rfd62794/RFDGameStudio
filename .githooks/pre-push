#!/bin/sh
# Local replacement for GitHub Actions CI: run the checks before every push.
# Install once per clone with: powershell -File scripts/install-hooks.ps1
# Skip once with: git push --no-verify
# Docs-only pushes (e.g. the AgentFlow queue's bookkeeping commits under
# docs/directives/*.md) skip the check suite below since they cannot break code.

toplevel="$(git rev-parse --show-toplevel)"
zero="0000000000000000000000000000000000000000"
run_checks() {
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$toplevel/scripts/check.ps1"
}

all_files=""
saw_line=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    saw_line=1

    # Branch deletion: nothing to check for this ref.
    [ "$local_sha" = "$zero" ] && continue

    if [ "$remote_sha" = "$zero" ]; then
        # New branch: diff against where it forked from main.
        base="$(git merge-base "$local_sha" origin/main 2>/dev/null)"
        if [ -z "$base" ]; then
            run_checks
        fi
    else
        base="$remote_sha"
    fi

    files="$(git diff --name-only "$base" "$local_sha")"
    [ -n "$files" ] && all_files="$all_files
$files"
done

if [ "$saw_line" = "0" ]; then
    exit 0
fi

all_files="$(printf '%s\n' "$all_files" | sed '/^$/d' | sort -u)"

if [ -z "$all_files" ]; then
    exit 0
fi

docs_only=1
count=0
while IFS= read -r f; do
    [ -z "$f" ] && continue
    count=$((count + 1))
    case "$f" in
        docs/*)
            ;;
        *.md)
            case "$f" in
                */*) docs_only=0 ;;
            esac
            ;;
        *)
            docs_only=0
            ;;
    esac
done <<EOF
$all_files
EOF

if [ "$docs_only" = "1" ]; then
    echo "pre-push: docs-only push ($count files), skipping checks"
    exit 0
fi

run_checks
