# =============================================================================
# Project-specific
# =============================================================================

# Never commit generated game state or simulation output
output/
sim_results/

# Generated arcade metadata (built from git history at build time)
ts/src/games/game-metadata.json
ts/src/games/arcade-manifest.json
ts/src/games/registry-export.json

# Intake zips are raw AI Studio exports; MANIFEST.md is tracked.
intake/**/*.zip

# Lua compiled bytecode (should never appear, but just in case)
*.luac

# Examples: everything under examples/ is tracked; dependencies and build output are ignored by the node_modules/ and dist/ rules above.

# Screenshots
screenshots/
screenshots/arcade-verify/

# Saves
saves/

# Stress Output
/scripts/stress_output*

# Temp Slime Garden Zip
temp_slimegarden_zip/

# One-off audit scratch drivers (never committed; keep working tree clean)
/_audit_*.py

# Pipeline audit run artifacts (live suite logs + pid files)
docs/state/pipeline_audit/

# Dist folders (generated build outputs)
dist*/

# Local build output, caches and one-off artifacts (untracked 2026-09-13)
local-arcade-preview/
.vite/
*.timestamp-*.mjs
ts/tsc-errors.txt
ts/*.zip
*.bak

# rpgCore archive: runtime output if the archived code is run locally
archive/rpgCore/logs/
archive/rpgCore/saves/
archive/rpgCore/data/*.sqlite
archive/rpgCore/**/*.log
